# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables).

# Resend API key (https://resend.com/api-keys). Required for the contact form to send.
RESEND_API_KEY=

# Optional. Where messages go (defaults to brexcel14@gmail.com).
# With the default sender below, Resend only delivers to the email you signed up to Resend with.
CONTACT_TO=

# Optional. Sender once you verify your own domain in Resend, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=
